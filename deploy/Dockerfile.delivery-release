# syntax=docker/dockerfile:1
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG RELEASE_REVISION
LABEL org.opencontainers.image.revision=$RELEASE_REVISION \
      org.opencontainers.image.base.name=$BASE_IMAGE

COPY delivery-release.json /tmp/orion-delivery-release.json
RUN python - <<'PY'
from hashlib import sha256
import json
import os
from pathlib import Path

manifest = json.loads(Path("/tmp/orion-delivery-release.json").read_bytes())
assert manifest["base_image"] == os.environ["BASE_IMAGE"]
assert manifest["release"] == os.environ["RELEASE_REVISION"]
root = Path("/srv/app")
for name, versions in manifest["files"].items():
    path = root / name
    assert path.resolve().is_relative_to(root), name
    expected = versions["live_before"]
    if expected is None:
        assert not path.exists() and not path.is_symlink(), name
    else:
        assert path.is_file() and not path.is_symlink(), name
        assert sha256(path.read_bytes()).hexdigest() == expected, name
PY
COPY --chown=appuser:appuser overlay/ /srv/app/
USER root
RUN python -m pip install --no-deps --only-binary=:all: -c requirements.lock cryptography==50.0.0 Pillow==13.0.0 opentelemetry-api==1.45.2 \
    && python -m pip install --no-deps --force-reinstall . \
    && python -m pip check
USER appuser
RUN python - <<'PY'
from hashlib import sha256
import json
from pathlib import Path

manifest = json.loads(Path("/tmp/orion-delivery-release.json").read_bytes())
for name, versions in manifest["files"].items():
    data = (Path("/srv/app") / name).read_bytes()
    assert sha256(data).hexdigest() == versions["live_after"], name
PY
