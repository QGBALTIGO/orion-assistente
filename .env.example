# EXEMPLO: deixe senhas vazias até gerar valores aleatórios exclusivos.
# NUNCA faça commit de .env nem use credenciais reais em arquivos versionados.
POSTGRES_DB=barber_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_SUPPORT_PASSWORD=
# Gere token aleatório >=32 caracteres, nunca senha da Railway.
SUPPORT_API_TOKEN=
# Opcional: leitor restrito a apenas uma barbearia autenticada
VIEWER_API_TOKEN=
VIEWER_TENANT_ID=
# Empresa fixa do painel para operadores globais sem vínculo pessoal.
# Use um UUID existente. Sem valor, o acesso só resolve quando há uma empresa no banco.
# Não concede nem altera vínculos de contas pessoais.
PANEL_OPERATOR_TENANT_ID=

# Contas comuns: confirmação por código antes de concluir novos cadastros.
# Ative apenas depois de aplicar/verificar as migrations e revisar a abertura.
PANEL_REGISTRATION_ENABLED=0
PANEL_OWNER_EMAIL=
# E-mail transacional: ambas as flags são obrigatórias para API/worker.
# Deixe desligado no exemplo; nenhum segredo ou destinatário real aqui.
PANEL_EMAIL_ENABLED=0
PANEL_EMAIL_LIVE_SEND=0
PANEL_EMAIL_TRANSPORT=resend_https
# Compatibilidade: neste transporte contém a chave API Resend de envio restrito.
PANEL_SMTP_PASSWORD=
# Remetente autorizado no domínio verificado, definido apenas no ambiente privado.
PANEL_SMTP_FROM=
# Mesmos valores estáveis na API e worker; não regenerar a cada deploy.
PANEL_OTP_SECRET=
PANEL_EMAIL_FERNET_KEY=
# Piloto restrito; sem destinatário configurado, o transporte não fica pronto.
PANEL_TEST_MODE=1
PANEL_TEST_EMAIL=
# Limites de tentativas; não são garantia de entrega nem capacidade para 10 mil.
PANEL_EMAIL_RATE_PER_SECOND=2
PANEL_EMAIL_DAILY_LIMIT=100
PANEL_EMAIL_RECIPIENT_DAILY_LIMIT=20
PANEL_EMAIL_REQUESTS_PER_RECIPIENT_HOUR=6
PANEL_EMAIL_REQUESTS_PER_HOUR=2000
# Diagnóstico separado: habilitar apenas para UMA execução expressamente autorizada.
ORION_EMAIL_DELIVERY_PROBE=0

# Meta oficial (somente quando conta/número forem autorizados)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_LIVE_SEND=0
INTEGRATION_FERNET_KEY=

# Google Calendar opt-in (sem credenciais reais no Git)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Origem HTTPS do callback já registrado; preservar ao mudar o domínio do painel.
GOOGLE_OAUTH_PUBLIC_ORIGIN=
GOOGLE_LIVE_SYNC=0

# FATIA 6: cobranças SaaS somente em Asaas sandbox; nunca usar API key real na demo
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX_API_KEY=
SALES_WHATSAPP_E164=

# Groq IA: somente homologação. Não publicar chave e não ativar automaticamente.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PREVIEW_ENABLED=0
# IA de gestão: geração revisável, sem envio automático. Ativação independente.
MANAGEMENT_AI_ENABLED=0
GROQ_MANAGEMENT_MODEL=openai/gpt-oss-120b
MANAGEMENT_AI_DAILY_LIMIT=50

# Site público: cada empresa precisa publicar sua versão pelo painel.
# Chave dedicada >=32 caracteres; se vazia, usa SUPPORT_API_TOKEN com derivação específica.
# Redis é obrigatório para limites atômicos e publicação. Não expor sua URL ao navegador.
PUBLIC_SITE_SIGNING_KEY=
# Origem HTTPS raiz usada em links, SEO e e-mails; sem caminho, senha ou token.
# Exemplo de formato: https://seu-dominio.example (definir o real fora do Git).
PANEL_PUBLIC_URL=
# Origens antigas explícitas separadas por vírgula (máximo 8), nunca wildcard.
# Compatibilidade não compartilha cookies nem relaxa CSRF do painel.
PANEL_LEGACY_PUBLIC_ORIGINS=

# Atendimento via aparelho vinculado: desligado até validação e consentimento.
QR_AI_ENABLED=0
QR_AI_TENANT_ID=
QR_AI_ALLOWED_SENDERS=
# Somente para o serviço QR bridge (DNS interno Railway)
QR_AI_API_URL=http://orion-assistente.railway.internal:8080/internal/qr/ai/reply

# Áudio: desativado por padrão. Habilitar somente com allowlist de teste.
QR_AI_AUDIO_ENABLED=0
GROQ_PROBE_ON_START=0

# Novas capacidades: aplicar migrations e homologar em ambiente isolado antes.
# Nenhuma flag abaixo conecta sessão, publica site ou atesta consentimento.
ONBOARDING_ENABLED=0
QR_CHANNELS_ENABLED=0
# Origem interna da API (sem caminho), usada somente no bridge gerenciado.
QR_CHANNEL_BROKER_URL=
MARKETING_EXECUTION_ENABLED=0
# Coleta opcional por finalidade; habilitar somente após migração 0029 e revisão.
BIRTHDAY_COLLECTION_ENABLED=0
# Manter consulta de recibos ao pausar novos envios depois da homologação.
MARKETING_RECONCILIATION_ENABLED=0
# CRM labels and quick-reply preparation. Apply migrations and validate first.
INBOX_TOOLS_ENABLED=0
# Persistent arbitration for managed QR channels, propagated by the API lease.
# Unknown sends remain blocked until a read-only bridge receipt is conclusive.
INBOX_CONTROL_ENABLED=0
# Independent opt-in for the durable human/Meta outbox. Never set for local UI QA.
# META_LIVE_SEND remains additionally required for every real Meta transport.
INBOX_SEND_ENABLED=0
QR_LEGACY_CENTRAL_ENABLED=0
