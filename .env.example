# EXEMPLO: deixe senhas vazias até gerar valores aleatórios exclusivos.
# NUNCA faça commit de .env nem use credenciais reais em arquivos versionados.
POSTGRES_DB=barber_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_SUPPORT_PASSWORD=
# Gere token aleatório >=32 caracteres, nunca senha da Railway.
SUPPORT_API_TOKEN=
# Opcional: leitor restrito a apenas uma barbearia autenticada
VIEWER_API_TOKEN=
VIEWER_TENANT_ID=

# Meta oficial (somente quando conta/número forem autorizados)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_LIVE_SEND=0
INTEGRATION_FERNET_KEY=

# Google Calendar opt-in (sem credenciais reais no Git)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LIVE_SYNC=0

# FATIA 6: cobranças SaaS somente em Asaas sandbox; nunca usar API key real na demo
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX_API_KEY=
SALES_WHATSAPP_E164=

# Groq IA: somente homologação. Não publicar chave e não ativar automaticamente.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PREVIEW_ENABLED=0

# Atendimento via aparelho vinculado: desligado até validação e consentimento.
QR_AI_ENABLED=0
QR_AI_TENANT_ID=
QR_AI_ALLOWED_SENDERS=
# Somente para o serviço QR bridge (DNS interno Railway)
QR_AI_API_URL=http://orion-assistente.railway.internal:8080/internal/qr/ai/reply
