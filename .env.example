# EXEMPLO: deixe senhas vazias até gerar valores aleatórios exclusivos.
# NUNCA faça commit de .env nem use credenciais reais em arquivos versionados.
POSTGRES_DB=barber_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_SUPPORT_PASSWORD=
# Gere token aleatório >=32 caracteres, nunca senha da Railway.
SUPPORT_API_TOKEN=
# Opcional: leitor restrito a apenas uma barbearia autenticada
VIEWER_API_TOKEN=
VIEWER_TENANT_ID=

# Meta oficial (somente quando conta/número forem autorizados)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_LIVE_SEND=0
INTEGRATION_FERNET_KEY=

# Google Calendar opt-in (sem credenciais reais no Git)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LIVE_SYNC=0

# FATIA 6: cobranças SaaS somente em Asaas sandbox; nunca usar API key real na demo
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX_API_KEY=
SALES_WHATSAPP_E164=

# Groq IA: somente homologação. Não publicar chave e não ativar automaticamente.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PREVIEW_ENABLED=0
# IA de gestão: geração revisável, sem envio automático. Ativação independente.
MANAGEMENT_AI_ENABLED=0
GROQ_MANAGEMENT_MODEL=openai/gpt-oss-120b
MANAGEMENT_AI_DAILY_LIMIT=50

# Site público: cada empresa precisa publicar sua versão pelo painel.
# Chave dedicada >=32 caracteres; se vazia, usa SUPPORT_API_TOKEN com derivação específica.
# Redis é obrigatório para limites atômicos e publicação. Não expor sua URL ao navegador.
PUBLIC_SITE_SIGNING_KEY=
# Origem HTTPS usada nos links de convite, sem caminho, senha ou token.
PANEL_PUBLIC_URL=

# Atendimento via aparelho vinculado: desligado até validação e consentimento.
QR_AI_ENABLED=0
QR_AI_TENANT_ID=
QR_AI_ALLOWED_SENDERS=
# Somente para o serviço QR bridge (DNS interno Railway)
QR_AI_API_URL=http://orion-assistente.railway.internal:8080/internal/qr/ai/reply

# Áudio: desativado por padrão. Habilitar somente com allowlist de teste.
QR_AI_AUDIO_ENABLED=0
GROQ_PROBE_ON_START=0

# Avisos transacionais da Agenda. Independentes da IA e de marketing.
# Ativar apenas após a migração 0020, em API, worker e bridge.
ORION_APPOINTMENT_NOTICES_ENABLED=0
# API e worker usam o vínculo QR_AI_TENANT_ID/QR_BRIDGE_URL/QR_BRIDGE_TOKEN existente.
# A bridge também precisa de QR_AI_TENANT_ID e volume persistente /data.
