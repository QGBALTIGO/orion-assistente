+  await assert.rejects(broker.lease(randomUUID(),'synthetic-key-not-a-production-secret','check',randomUUID(),1),
+    error=>error instanceof SyntaxError&&error.code!=='CHANNEL_BROKER_TEMPORARILY_UNAVAILABLE');
